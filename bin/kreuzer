#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kreuzer - launcher. Locates the library directory and hands over; all
# behaviour lives in lib/kreuzer so tests can source it without a terminal.

# Resolve symlinks: the launcher is usually linked into a git checkout.
self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1

# An explicit override wins (development, tests), then the tree next to this
# script (checkout or PREFIX install), then the distro path.
lib=
for dir in "${KREUZER_LIBDIR:-}" "${self%/*}/../lib/kreuzer" /usr/lib/kreuzer; do
  if [[ -n $dir && -r $dir/main.sh ]]; then
    lib=$(cd -- "$dir" && pwd -P)
    break
  fi
done
[[ -n $lib ]] || { echo "kreuzer: cannot locate its library directory" >&2; exit 1; }
KREUZER_LIBDIR=$lib

# Launcher variables must not leak into the application's namespace.
unset self lib dir

# shellcheck source=/dev/null
source "$KREUZER_LIBDIR/main.sh"
main "$@"
exit $?
